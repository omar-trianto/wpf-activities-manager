<Window x:Class="activities_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:activities_wpf"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="440" Width="480">
    <Grid>
        <TabControl>
            <TabItem Header="Add new fitness activity">
                <Grid Background="#FFE5E5E5">
                    <Label Content="Date and Time" HorizontalAlignment="Left" Margin="32,35,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.5,-0.575"/>
                    <xctk:DateTimePicker 
                        x:Name="addDate"
                        Format="Custom" 
                        FormatString="dd/MM/yyyy HH:mm" 
                        Value="{x:Static system:DateTime.Now}"
                        HorizontalAlignment="Left" Margin="198,36,0,0" VerticalAlignment="Top" Width="238"/>
                    <Label Content="Title" HorizontalAlignment="Left" Margin="32,66,0,0" VerticalAlignment="Top"/>
                    <TextBox 
                        x:Name="addTitle"
                        HorizontalAlignment="Left" Margin="198,70,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="238"/>
                    <Label Content="Cost" HorizontalAlignment="Left" Margin="32,97,0,0" VerticalAlignment="Top"/>
                    <TextBox 
                        x:Name="addCost"
                        HorizontalAlignment="Left" Margin="198,101,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="238"/>
                    <TabControl Margin="32,157,38,92">
                        <TabItem Header="Fitness">
                            <Grid Background="White">
                                <Label Content="Location" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                                <TextBox 
                                    x:Name="addLocation"
                                    HorizontalAlignment="Center" Margin="0,41,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="378"/>
                                <Button Content="Save Fitness Activity" HorizontalAlignment="Center" Margin="0,73,0,0" VerticalAlignment="Top" Width="378" Click="saveFitness_Click"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Entertainment">
                            <Grid Background="White">
                                <Label Content="Minimum participants" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                                <TextBox 
                                    x:Name="addParticipants"
                                    HorizontalAlignment="Center" Margin="0,41,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="378"/>
                                <Button Content="Save Entertainment Activity" HorizontalAlignment="Center" Margin="0,73,0,0" VerticalAlignment="Top" Width="378" Click="saveEntertainment_Click"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="Search and display all activities">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="87*"/>
                        <ColumnDefinition Width="25*"/>
                        <ColumnDefinition Width="71*"/>
                        <ColumnDefinition Width="291*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Search Date" HorizontalAlignment="Left" Margin="33,38,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <xctk:DateTimePicker 
                        x:Name="searchDate"
                        Format="Custom" 
                        FormatString="dd/MM/yyyy HH:mm" 
                        Value="{x:Static system:DateTime.Now}"
                        HorizontalAlignment="Left" Margin="3,39,0,0" VerticalAlignment="Top" Width="236" Grid.Column="3"/>
                    <Label Content="Search Criteria" HorizontalAlignment="Left" Margin="33,69,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
                    <RadioButton x:Name="searchBefore" GroupName="searchRadio"
                        Content="Before" HorizontalAlignment="Left" Margin="3,75,0,0" VerticalAlignment="Top" Grid.Column="3"/>
                    <RadioButton x:Name="searchOn" GroupName="searchRadio" IsChecked="True"
                        Content="On" HorizontalAlignment="Left" Margin="104,75,0,0" VerticalAlignment="Top" Grid.Column="3"/>
                    <RadioButton x:Name="searchAfter" GroupName="searchRadio"
                        Content="After" HorizontalAlignment="Left" Margin="194,75,0,0" VerticalAlignment="Top" Grid.Column="3"/>
                    <Button Content="Search Activities" HorizontalAlignment="Left" Margin="33,100,0,0" VerticalAlignment="Top" Width="389" Grid.ColumnSpan="4" Click="Search_Click"/>
                    <Button Content="Display All Activities" HorizontalAlignment="Left" Margin="33,135,0,0" VerticalAlignment="Top" Width="389" Click="DisplayAll_Click" Grid.ColumnSpan="4"/>
                    <DataGrid 
                        x:Name="dgActivities" AutoGenerateColumns="True"
                        ItemsSource="{Binding}"
                        Margin="33,170,52,10"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        IsReadOnly="True" Grid.ColumnSpan="4"
                        />
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
